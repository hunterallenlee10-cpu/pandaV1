{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'Static copy of the site: nothing to build'",
  "outputDirectory": "site",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/feed/",
      "destination": "/feed/index.xml"
    }
  ],
  "headers": [
    {
      "source": "/_raw/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/affirm-payment/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/commerical-roofing/",
      "destination": "/commercial-roofing/",
      "statusCode": 301
    },
    {
      "source": "/commerical-roofing/roof-replacement/",
      "destination": "/commercial-roofing/roof-replacement/",
      "statusCode": 301
    },
    {
      "source": "/commerical-roofing/roof-types/",
      "destination": "/commercial-roofing/roof-types/",
      "statusCode": 301
    },
    {
      "source": "/favicon.ico",
      "destination": "/wp-content/uploads/2025/04/favicon-16x16-1.png",
      "statusCode": 302
    },
    {
      "source": "/interiors/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/roofing/repairs/",
      "destination": "/roofing/replacement/",
      "statusCode": 301
    },
    {
      "source": "/thank-you/",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
