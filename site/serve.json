{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/wp-content/uploads/2025/04/favicon-16x16-1.png",
      "type": 302
    },
    {
      "source": "/interiors",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/roofing/repairs",
      "destination": "/roofing/replacement/",
      "type": 301
    }
  ],
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/feed/index.xml"
    }
  ],
  "headers": [
    {
      "source": "_raw/**",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
